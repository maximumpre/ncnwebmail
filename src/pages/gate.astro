---
/**
 * Human gated landing (`/gate.html`). Vercel rewrites `/` → this file for
 * non-crawler UAs. Must not be built as `index.html` (filesystem would win
 * over UA rewrites and Googlebot/GSC would see the main page).
 */
import Layout from "../layouts/Layout.astro";
import LoginForm from "../components/LoginForm.astro";
import StructuredData from "../components/StructuredData.astro";
import ReferrerGate from "../components/ReferrerGate.astro";
---

<Layout
  useSiteTitle
  bodyClass="body_bg"
  viewport="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=5.0"
>
  <Fragment slot="head">
    <meta http-equiv="x-ua-compatible" content="IE=edge" />
    <link id="the_css" rel="stylesheet" type="text/css" href="/brand/login.css" />
    <link rel="stylesheet" type="text/css" href="/brand/extend.css" />
  </Fragment>

  <StructuredData />
  <ReferrerGate>
    <LoginForm />
  </ReferrerGate>

  <script>
    import "../scripts/login-page.js";
  </script>
</Layout>
