# Ops Telegram (required together)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SEO admin Telegram — IndexNow deploy notify + SEO alerts
# Required on Vercel Build env (not Runtime-only) for IndexNow Telegram on deploy
TELEGRAM_SEO_BOT_TOKEN=
TELEGRAM_SEO_ADMIN=

# Local QA unlock (never honor as production green)
ALLOW_LOCAL_TESTING=true
CSP=0

# Optional
ADMIN_PORTAL_URL=
DATABASE_URL=
